                "uid": "prometheus"
              },
              "expr": "sum by(status) (increase(app:http_requests_total{job=\"$job\", status_code=~\"5..\"}[$__rate_interval]))",
              "legendFormat": "{{status}} (server error)"
            },
            {
              "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
              },
              "expr": "sum by(status) (increase(app:http_requests_total{job=\"$job\", status_code=~\"4..\"}[$__rate_interval]))",
              "legendFormat": "{{status}} (client error)"
            }
          ],
          "title": "Error Count by Status Code (per scrape interval)",
          "type": "timeseries",
          "options": {
            "tooltip": {
              "mode": "multi"
            },
            "legend": {
              "displayMode": "list",
              "placement": "bottom"
            }
          },
          "description": "**What it measures:** Count of error responses by HTTP status code in each interval.\n\nUses `increase()` to show the actual number of errors rather than a rate.\n\n**Click any line to drill into the Error Endpoint Drilldown table.**",
          "interval": "1m"
        }
      ]
