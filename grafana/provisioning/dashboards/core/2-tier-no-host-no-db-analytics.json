  "graphTooltip": 1,
  "links": [
    {
      "asDropdown": false,
      "icon": "arrow-left",
      "includeVars": false,
      "keepTime": true,
      "tags": [],
      "targetBlank": false,
      "title": "← All Teams",
      "tooltip": "Back to the All Teams overview (this dashboard is shared across every team, so there's no single 'correct' team to return to)",
      "type": "link",
      "url": "/d/all-teams-overview"
    }
  ],
