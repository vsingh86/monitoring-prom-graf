                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "red",
                "value": 3
              }
            ]
          },
          "links": [
            {
              "title": "Performance Drilldown →",
              "url": "/d/2-tier-no-host-no-db-analytics?var-job=$job&viewPanel=200",
              "targetBlank": false
            }
          ]
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "p99"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "id": 10,
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.50, sum(rate(app:http_request_duration_seconds_bucket{job=\"$job\"}[$__rate_interval])) by (le))",
          "legendFormat": "p50"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum(rate(app:http_request_duration_seconds_bucket{job=\"$job\"}[$__rate_interval])) by (le))",
          "legendFormat": "p95"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.99, sum(rate(app:http_request_duration_seconds_bucket{job=\"$job\"}[$__rate_interval])) by (le))",
          "legendFormat": "p99"
        }
      ],
      "title": "Request Latency — p50 / p95 / p99",
      "type": "timeseries",
      "description": "**What it measures:** Time from when the service receives a request to when it sends the response, expressed as percentile distributions.\n\n**p50 (median):** Half of requests complete faster than this. Represents the typical user experience.\n\n**p95:** 1 in 20 requests is slower than this. A good SLA target for most APIs.\n\n**p99:** 1 in 100 requests is slower than this. Reveals tail latency that averages hide — the experience of your worst-affected users.\n\n**How collected:** Prometheus Histogram metric (`http_request_duration_seconds`). The application records the duration of every request. PromQL `histogram_quantile()` computes percentiles from the bucket counts.\n\n**Thresholds:** Warn p99 > 1s · Critical p99 > 3s. Tighten for payment or auth flows (Warn > 500ms).\n\n**Common causes of spikes:** Slow database queries, GC pauses, downstream dependency latency, thread pool saturation.",
      "interval": "1m"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqpm",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          },
          "links": [
            {
              "title": "Performance Drilldown →",
              "url": "/d/2-tier-no-host-no-db-analytics?var-job=$job&viewPanel=200",
              "targetBlank": false
            }
          ]
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 1
      },
      "id": 11,
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(sum(rate(app:http_requests_total{job=\"$job\"}[$__rate_interval]))) * 60",
          "legendFormat": "Total RPS"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(sum(rate(app:http_requests_total{job=\"$job\",status_code=~\"2..\"}[$__rate_interval]))) * 60",
          "legendFormat": "2xx RPS"
        }
      ],
      "title": "Traffic — Requests per Minute",
      "type": "timeseries",
      "description": "**What it measures:** The volume of requests your application is processing per second, broken down by HTTP status class.\n\n**Why it matters:** Traffic is your baseline. All other metrics must be interpreted relative to it. A 1% error rate means very different things at 10 RPS vs 10,000 RPS.\n\n**How collected:** Prometheus Counter (`app:http_requests_total`) incremented on every request. PromQL `rate()` converts the cumulative counter into a per-second rate over a sliding window.\n\n**What to watch:** Sudden drops (traffic fell away — routing issue?) are as important as spikes. Compare to same time yesterday using `offset 1d` in PromQL.\n\n**Thresholds:** Alert on deviation > 3× from rolling baseline rather than a fixed number.",
      "interval": "1m"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 15
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.01
              },
              {
                "color": "red",
                "value": 0.05
              }
            ]
          },
          "links": [
            {
              "title": "Error Drilldown →",
              "url": "/d/2-tier-no-host-no-db-analytics?var-job=$job&viewPanel=201",
              "targetBlank": false
            }
          ]
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 9
      },
      "id": 12,
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(app:http_requests_total{job=\"$job\", status_code=~\"5..\"}[$__rate_interval]))",
          "legendFormat": "5xx errors (count)"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(app:http_requests_total{job=\"$job\", status_code=~\"4..\"}[$__rate_interval]))",
          "legendFormat": "4xx errors (count)"
        }
      ],
      "title": "Error Count — 4xx / 5xx (per scrape interval)",
      "type": "timeseries",
      "description": "**What it measures:** Number of error responses in each scrape interval.\n\nUses `increase()` over `$__rate_interval` so every data point shows the actual count of errors in that window — not a per-second rate.\n\n**Click any data point to open the Error Drilldown table** (per-endpoint breakdown).",
      "interval": "1m"
    },
